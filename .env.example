# ---- Claude Code ----
# Default model for spawned Claude Code sessions (optional; SDK default otherwise).
CLAUDE_MODEL=

# Permission mode: "acceptEdits" (default, auto-accept file edits - needed for headless) | "bypassPermissions" | "default" | "plan".
CLAUDE_PERMISSION_MODE=acceptEdits

# Hard per-task wall-clock timeout (ms). A task that hangs (e.g. waiting on a
# permission prompt) is auto-aborted so it can't block the chat. 1800000 = 30m
# (raised from 10m; real coding tasks need longer). Set 0 to disable the watchdog.
CLAUDE_TASK_TIMEOUT_MS=1800000

# Comma-separated tool names to allow (optional). e.g. "Bash(git *),Edit,Read"
CLAUDE_ALLOWED_TOOLS=

# DANGEROUS: set to true to pass --dangerously-skip-permissions. Off by default.
CLAUDE_ALLOW_DANGEROUS_SKIP_PERMISSIONS=false

# Cap agentic turns per task (osv runs at 50 via config.yaml defaults.maxTurns).
# Bounds a runaway tool loop so it can't run to the 30m watchdog. Unset = SDK default.
CLAUDE_MAX_TURNS=

# ---- CoBot ----
# SQLite database path (under data/ by default).
COBOT_DB_PATH=./data/cobot.db

# Outbound HTTP proxy for reaching Telegram (when the direct path is blocked or
# TLS-intercepted). If unset, the macOS system proxy (scutil --proxy) is used.
# COBOT_PROXY=http://127.0.0.1:10808

# Optional Hermes integration (v1.5). Leave unset to disable.
# Requires enabling Hermes api_server (see scripts/enable-hermes-apiserver.sh).
# HERMES_API_URL=http://127.0.0.1:8642
# HERMES_API_KEY=

# Log level: trace|debug|info|warn|error
LOG_LEVEL=info
